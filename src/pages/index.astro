---
// The front page: Gianni's name, then the things to look at.
// Gianni designs this page; this is a tidy first pass (2026-11-20).
import Base from "../layouts/Base.astro";
import { site } from "../config/site.js";
import { getEntry } from "astro:content";
import { existsSync } from "node:fs";
import { join } from "node:path";

// First link: the MD editor. Its address, code link and logo live in
// src/content/projects/md-editor.md, not here.
const md = await getEntry("projects", "md-editor");
if (!md) throw new Error("src/content/projects/md-editor.md is missing");
if (!md.data.url) throw new Error("projects/md-editor.md needs a url");
// A mistyped logo path stops the build instead of showing an empty slot.
if (md.data.logo && !existsSync(join(process.cwd(), "public", md.data.logo))) {
  throw new Error(`projects/md-editor.md: logo ${md.data.logo} is not in public/`);
}
const mdHost = new URL(md.data.url).host;
// On narrow screens the address may wrap, but only before a dot.
const [hostFirst, ...hostRest] = mdHost.split(".");
---
<Base>
  <h1 class="site-name">{site.name}</h1>

  {md.data.shown && (
  <ul class="links" role="list">
    <li class="link-card">
      <div class="link-row">
        <a class="link-main" href={md.data.url}>
          {md.data.logo && (
            <img class="link-logo" src={md.data.logo} alt="" width="48" height="48" />
          )}
          <span>{hostFirst}{hostRest.map((part) => <Fragment><wbr />.{part}</Fragment>)}</span>
        </a>
        {md.data.repo && (
          <a class="link-code" href={md.data.repo}>Code on GitHub<span class="visually-hidden"> for {md.data.title}</span></a>
        )}
      </div>
      {md.data.tagline && <p class="link-tagline">{md.data.tagline}</p>}
      {md.data.tip && <p class="link-tip">{md.data.tip}</p>}
    </li>
  </ul>
  )}
</Base>
